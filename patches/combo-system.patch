+      timerLabel.replaceChildren(
+        part(`${opts.label || "Hurry"} [`),
+        part("#".repeat(filled), "combo-bar-fill"),
+        part("-".repeat(TIMER_SLOTS - filled), "combo-bar-empty"),
+        part(`] ${(left / 1000).toFixed(1)}s`)
+      );
+      timerBox.classList.toggle("urgent", left < 1500);

+/* =====================================================================
+   THE LAST SAVE: visual theme
+   Design tokens first, then layout, then game-text styling, then the
+   effect animations that effects.js triggers (kept at the bottom).
+   ===================================================================== */
+
+:root {
+  color-scheme: dark;
+
+  /* surfaces */
+  --bg-deep: #06080c;
+  --bg-term: #0a0e14;
+  --bg-panel: #0f151d;
+  --bg-raised: #151d28;
+  --line: #1e2a38;
+  --line-soft: #162130;
+
+  /* text */
+  --text: #dce6ef;
+  --text-strong: #f4f8fb;
+  --muted: #7f8fa0;
+  --faint: #4b5868;
+
+  /* accents */
+  --accent: #5eead4;
+  --accent-dim: #5eead42e;
+  --gold: #f5c76b;
+  --red: #ff6b7a;
+  --green: #5ee09a;
+  --blue: #6cb6ff;
+  --violet: #b99bff;
+  --orange: #ff9f6b;
+  --cyan: #7ff0e0;
+
+  --radius: 14px;
+  --mono: ui-monospace, "Cascadia Code", "JetBrains Mono", "SF Mono", "Fira Code", Consolas, "Liberation Mono", "Courier New", monospace;
+}
+
+* { box-sizing: border-box; }
+
+html, body { margin: 0; height: 100%; }
+
+body {
+  min-height: 100vh;
+  min-height: 100dvh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: clamp(8px, 2.5vw, 28px);
+  font-family: var(--mono);
+  color: var(--text);
+  background:
+    radial-gradient(ellipse 80% 55% at 50% -10%, #12313a66, transparent 70%),
+    radial-gradient(ellipse 60% 45% at 100% 100%, #2a1b4a44, transparent 70%),
+    var(--bg-deep);
+}
+
+/* ---------- window frame ---------- */
+
+.terminal {
+  position: relative;
+  width: min(1180px, 100%);
+  height: min(900px, 94vh);
+  height: min(900px, 94dvh);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  background: var(--bg-term);
+  border: 1px solid #2a3a4c;
+  border-radius: var(--radius);
+  box-shadow:
+    0 30px 80px #000c,
+    0 0 0 1px #ffffff06 inset,
+    0 0 60px #5eead412;
+}
+
+/* soft CRT: faint scanlines and a vignette; sits above the text but never blocks clicks */
+.terminal::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 4;
+  pointer-events: none;
+  background:
+    repeating-linear-gradient(to bottom, #00000000 0 2px, #00000016 3px),
+    radial-gradient(ellipse at center, transparent 62%, #00000066 100%);
+  border-radius: inherit;
+}
+
+/* ---------- header ---------- */
+
+.bar {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 60px;
+  padding: 10px 16px;
+  color: var(--text-strong);
+  background: linear-gradient(180deg, #162029, #0f151d);
+  border-bottom: 1px solid var(--line);
+}
+
+.window-controls { display: flex; gap: 6px; flex: 0 0 auto; }
+.dot { width: 10px; height: 10px; border-radius: 50%; background: #555; }
+.dot:nth-child(1) { background: #ff6f64; box-shadow: 0 0 8px #ff6f6466; }
+.dot:nth-child(2) { background: #f2c14e; box-shadow: 0 0 8px #f2c14e66; }
+.dot:nth-child(3) { background: #5ee09a; box-shadow: 0 0 8px #5ee09a66; }
+
+.brand-mark {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  flex: 0 0 auto;
+  border-radius: 10px;
+  font-weight: 800;
+  font-size: 14px;
+  letter-spacing: -0.5px;
+  color: #06201c;
+  background: linear-gradient(135deg, var(--accent), #3fb6ff);
+  box-shadow: 0 0 18px #5eead455, 0 0 0 1px #ffffff30 inset;
+}
+
+.brand-copy { min-width: 0; }
+.title {
+  margin: 0;
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: 0.22em;
+  color: var(--text-strong);
+}
+.edition {
+  margin-top: 3px;
+  font-size: 10px;
+  letter-spacing: 0.16em;
+  color: var(--muted);
+}
+
+.toolbar { display: flex; align-items: center; gap: 8px; margin-left: auto; }
+
+button {
+  font: inherit;
+  cursor: pointer;
+  color: var(--text);
+  background: var(--bg-raised);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 6px 10px;
+  transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
+}
+button:hover { background: #1c2735; border-color: #34475c; }
+
+.toolbar button {
+  font-size: 11px;
+  border-radius: 999px;
+  padding: 7px 13px;
+  color: #c3d1dd;
+  background: #ffffff08;
+  border-color: #ffffff14;
+}
+.toolbar button:hover {
+  color: var(--accent);
+  background: var(--accent-dim);
+  border-color: #5eead466;
+  transform: translateY(-1px);
+}
+
+.music-volume {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  padding: 5px 11px;
+  font-size: 11px;
+  white-space: nowrap;
+  color: #c3d1dd;
+  background: #ffffff08;
+  border: 1px solid #ffffff14;
+  border-radius: 999px;
+}
+#musicVolume { width: 84px; cursor: pointer; accent-color: var(--accent); }
+#musicVolumeValue { width: 32px; text-align: right; color: var(--muted); }
+
+/* ---------- game screen ---------- */
+
+#screen {
+  flex: 1;
+  min-height: 0;
+  overflow: auto;
+  padding: clamp(16px, 2.6vw, 30px);
+  font-size: 15px;
+  line-height: 1.6;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  cursor: text;
+  color: var(--text);
+  background:
+    radial-gradient(ellipse 90% 60% at 50% 0%, #101a24, transparent 75%),
+    var(--bg-term);
+  scrollbar-width: thin;
+  scrollbar-color: #2f4256 transparent;
+  /* soft fade where text scrolls under the header and input */
+  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 18px, #000 calc(100% - 14px), transparent 100%);
+  mask-image: linear-gradient(to bottom, transparent 0, #000 18px, #000 calc(100% - 14px), transparent 100%);
+}
+#screen:focus { outline: none; }
+#screen::-webkit-scrollbar { width: 10px; }
+#screen::-webkit-scrollbar-track { background: transparent; }
+#screen::-webkit-scrollbar-thumb {
+  background: #243445;
+  border-radius: 8px;
+  border: 2px solid var(--bg-term);
+}
+#screen::-webkit-scrollbar-thumb:hover { background: #34506a; }
+#screen ::selection { background: #5eead440; }
+
+/* ---------- command input ---------- */
+
+.input-row {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 58px;
+  padding: 10px 16px;
+  background: var(--bg-panel);
+  border-top: 1px solid var(--line);
+}
+.prompt {
+  user-select: none;
+  font-weight: 800;
+  color: var(--accent);
+  text-shadow: 0 0 10px #5eead488;
+}
+#command {
+  flex: 1;
+  min-width: 0;
+  min-height: 38px;
+  padding: 7px 14px;
+  font: inherit;
+  font-size: 15px;
+  color: var(--text-strong);
+  caret-color: var(--accent);
+  background: #0a0f15;
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  outline: 0;
+  transition: border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
+}
+#command:focus {
+  background: #0c131b;
+  border-color: #5eead477;
+  box-shadow: 0 0 0 3px #5eead41a, 0 0 18px #5eead41f;
+}
+#command::placeholder { color: #5d6c7c; }
+
+/* ---------- combo timer ---------- */
+
+.combo-timer {
+  flex: 0 0 auto;
+  padding: 7px 18px;
+  font-size: 0.96em;
+  font-weight: 700;
+  color: var(--gold);
+  background: linear-gradient(90deg, #f5c76b1c, transparent 75%);
+  border-top: 1px solid var(--line);
+  border-left: 3px solid var(--gold);
+}
+.combo-timer[hidden] { display: none; }
+.combo-bar-fill { color: var(--gold); text-shadow: 0 0 8px #f5c76b99; }
+.combo-bar-empty { color: #4a4228; }
+.combo-timer.urgent {
+  color: var(--red);
+  border-left-color: var(--red);
+  background: linear-gradient(90deg, #ff6b7a22, transparent 75%);
+  animation: pulse 0.5s ease-in-out infinite;
+}
+.combo-timer.urgent .combo-bar-fill { color: var(--red); text-shadow: 0 0 8px #ff6b7a99; }
+
+/* ---------- footer ---------- */
+
+.terminal-footer {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  min-height: 44px;
+  padding: 7px 16px;
+  background: #0b1016;
+  border-top: 1px solid var(--line-soft);
+}
+.footer-settings {
+  display: inline-flex;
+  align-items: center;
+  min-height: 29px;
+  padding: 5px 12px;
+  font-size: 11px;
+  white-space: nowrap;
+  color: #a8ecdc;
+  background: #5eead40d;
+  border: 1px solid #5eead433;
+  border-radius: 999px;
+}
+.footer-settings:hover:not(:disabled) { color: #d6fff1; background: #5eead41c; border-color: #5eead488; }
+.footer-settings:disabled { cursor: wait; opacity: 0.8; }
+.footer-settings.is-loading { color: var(--gold); border-color: #f5c76b44; background: #f5c76b0c; }
+.footer-settings.is-loading::before {
+  content: "⏳";
+  display: inline-block;
+  margin-right: 6px;
+  animation: loading-pulse 0.9s ease-in-out infinite alternate;
+}
+.footer-settings.is-unavailable { color: #f0a9a9; border-color: #f0a9a945; background: #f0a9a90b; }
+.footer-settings:focus-visible,
+.toolbar button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+.footer-meta { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
+.help, .version { padding: 0; font-size: 10px; white-space: nowrap; color: var(--muted); }
+.version { letter-spacing: 0.12em; color: #aebdca; }
+
+@keyframes loading-pulse { to { opacity: 0.45; transform: translateY(-1px); } }
+
+/* ---------- game text ---------- */
+
+.line { animation: line-in 0.24s ease-out both; }
+@keyframes line-in { from { opacity: 0; } to { opacity: 1; } }
+
+/* combat feedback */
+.fx-hurt   { color: var(--red); font-weight: 700; }
+.fx-hit    { color: var(--gold); }
+.fx-crit   { color: #ffe27a; font-weight: 800; text-shadow: 0 0 10px #ffb30099; }
+.fx-parry  { color: var(--blue); font-weight: 700; }
+.fx-dodge  { color: var(--cyan); }
+.fx-heal   { color: var(--green); }
+.fx-status { color: #d99bff; }
+.fx-loot   { color: var(--gold); }
+.fx-dim    { color: var(--faint); }
+.fx-can    { color: var(--green); }
+.fx-cant   { color: #c9737a; }
+.fx-turn-player { color: var(--green); font-weight: 800; letter-spacing: 0.04em; }
+.fx-turn-enemy  { color: var(--red);   font-weight: 800; letter-spacing: 0.04em; }
+
+/* big moments get their own banner */
+.fx-chapter,
+.fx-levelup,
+.fx-win,
+.fx-lose,
+.fx-encounter {
+  display: block;
+  margin: 10px 0;
+  padding: 6px 14px;
+  font-weight: 800;
+  border-left: 3px solid currentColor;
+  border-radius: 0 8px 8px 0;
+  background: linear-gradient(90deg, color-mix(in srgb, currentColor 16%, transparent), transparent 80%);
+}
+.fx-chapter   { color: var(--violet); letter-spacing: 0.06em; text-shadow: 0 0 14px #8a5cff88; }
+.fx-levelup   { color: #ffe27a;       text-shadow: 0 0 12px #ffb30088; }
+.fx-win       { color: var(--green);  text-shadow: 0 0 10px #1faa5a88; }
+.fx-lose      { color: #ff4d5e;       text-shadow: 0 0 12px #a0000088; }
+.fx-encounter { color: var(--orange); }
+
+.fx-warning {
+  color: #ffb02e;
+  font-weight: 800;
+  animation: line-in 0.24s ease-out both, pulse 0.7s ease-in-out 3;
+}
+.fx-glitch {
+  color: var(--cyan);
+  animation: line-in 0.24s ease-out both, glitch 0.5s steps(2) 2;
+}
+
+/* enemy intent block */
+.fx-intent-head { color: var(--orange); font-weight: 800; letter-spacing: 0.14em; }
+.fx-intent-main { color: #ffdcbd; font-weight: 700; }
+
+/* reward feed */
+.fx-reward-feed {
+  display: block;
+  margin: 1px 0;
+  padding: 2px 10px;
+  font-size: 0.96em;
+  font-weight: 600;
+  line-height: 1.45;
+  text-align: left;
+  border-left: 2px solid #8a7c44;
+  background: linear-gradient(90deg, #f5c76b14, transparent 70%);
+}
+.reward-coin  { color: #a9e08d; }
+.reward-xp    { color: #f0d77f; }
+.reward-item  { color: #cfaeea; }
+.reward-combo { color: #f5b070; }
+
+/* HP / energy bars */
+.bar-good   { color: #4ee08a; text-shadow: 0 0 8px #4ee08a55; }
+.bar-warn   { color: #f5c13a; text-shadow: 0 0 8px #f5c13a55; }
+.bar-low    { color: #ff5a6a; text-shadow: 0 0 8px #ff5a6a66; }
+.bar-energy { color: #62b0ff; text-shadow: 0 0 8px #62b0ff55; }
+.bar-empty  { color: #2f3a47; }
+
+@keyframes pulse { 50% { opacity: 0.45; } }
+@keyframes glitch {
+  0%   { text-shadow: 2px 0 #ff2e63, -2px 0 #08d9d6; transform: translateX(-2px); }
+  50%  { text-shadow: -2px 0 #ff2e63, 2px 0 #08d9d6; transform: translateX(2px); }
+  100% { text-shadow: none; transform: none; }
+}
+
+/* ---------- screen shake, flash, floating numbers (effects.js) ---------- */
+
+.shake        { animation: shake 0.25s linear; }
+.shake-strong { animation: shake 0.45s linear; }
+@keyframes shake {
+  0%, 100% { transform: translate(0, 0); }
+  20% { transform: translate(-6px, 2px); }
+  40% { transform: translate(5px, -3px); }
+  60% { transform: translate(-4px, 3px); }
+  80% { transform: translate(3px, -2px); }
+}
+.fx-flash { position: absolute; inset: 0; pointer-events: none; opacity: 0; z-index: 5; }
+.fx-flash.on { animation: flash 0.45s ease-out; }
+@keyframes flash { 0% { opacity: 1; } 100% { opacity: 0; } }
+
+.fx-float {
+  position: absolute;
+  z-index: 6;
+  pointer-events: none;
+  font-size: 26px;
+  font-weight: 800;
+  animation: float-up 0.82s ease-out forwards;
+}
+.fx-float.hurt { color: #ff5a6a; text-shadow: 0 0 12px #a00000, 0 2px 0 #000; }
+.fx-float.hit  { color: var(--gold); text-shadow: 0 0 10px #8a5a00, 0 2px 0 #000; }
+.fx-float.crit { color: #ffe27a; font-size: 42px; text-shadow: 0 0 16px #ffb300, 0 2px 0 #000; }
+@keyframes float-up {
+  0%   { opacity: 0; transform: translateY(10px) scale(0.7); }
+  15%  { opacity: 1; transform: translateY(0) scale(1.15); }
+  100% { opacity: 0; transform: translateY(-60px) scale(1); }
+}
+
+/* ---------- accessibility options (set by the settings menu) ---------- */
+
+body.access-large #screen,
+body.access-large #command { font-size: 19px; line-height: 1.6; }
+body.access-spacing #screen { line-height: 1.85; letter-spacing: 0.025em; }
+body.access-reduced-flash .terminal::after { opacity: 0.5; }
+body.access-reduced-flash .fx-glitch { animation: none !important; text-shadow: none !important; }
+body.access-reduced-flash .fx-flash { display: none !important; }
+body.access-reduced-flash .shake,
+body.access-reduced-flash .shake-strong { animation: none !important; }
+body.access-reduced-flash .boss-attack-scene,
+body.access-reduced-flash .boss-attack-scene * { animation: none !important; }
+body.access-reduced-flash .boss-attack-scene::before { opacity: 0.72; }
+body.access-reduced-flash .fx-intent-head,
+body.access-reduced-flash .boss-attack-mark { text-shadow: none !important; }
+body.access-reduced-motion *,
+body.access-reduced-motion *::before,
+body.access-reduced-motion *::after {
+  animation-duration: 0.01ms !important;
+  animation-iteration-count: 1 !important;
+  scroll-behavior: auto !important;
+  transition-duration: 0.01ms !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .line, .shake, .shake-strong, .fx-warning, .fx-glitch, .combo-timer.urgent { animation: none; }
+  .footer-settings.is-loading::before { animation: none; }
+}
+
+/* ---------- small screens ---------- */
+
+@media (max-width: 700px) {
+  body { padding: 0; }
+  .terminal { width: 100%; height: 100vh; height: 100dvh; border-radius: 0; border-left: 0; border-right: 0; }
+  .bar { min-height: 56px; padding: 8px 10px; gap: 8px; }
+  .brand-mark { width: 30px; height: 30px; font-size: 12px; }
+  .edition, .window-controls { display: none; }
+  .toolbar { gap: 5px; }
+  .toolbar button { padding: 6px 9px; font-size: 10px; }
+  #musicVolume { width: 56px; }
+  #musicVolumeValue { display: none; }
+  .toolbar button { white-space: nowrap; }
+  #screen { font-size: 13.5px; }
+  .input-row { min-height: 52px; padding: 8px 10px; }
+  .terminal-footer { flex-wrap: wrap; gap: 5px 9px; padding: 7px 10px; }
+  .footer-meta { flex-basis: calc(100% - 160px); gap: 6px; }
+  .help, .version { font-size: 9px; }
+}
+@media (max-width: 420px) {
+  .title { font-size: 11px; letter-spacing: 0.12em; }
+  .toolbar button { padding: 6px 7px; font-size: 9px; }
+  .music-volume { padding: 4px 8px; }
+  .footer-meta { flex-direction: column; align-items: flex-end; gap: 2px; }
+}
